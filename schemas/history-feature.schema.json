{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hamk.dev/schemas/history-feature/1.0.0",
  "title": "Collision-history feature row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "block_id",
    "window_start",
    "window_end",
    "collision_count",
    "unique_pair_count",
    "repeated_pair_ratio",
    "vertex_count",
    "component_count",
    "cycle_rank",
    "largest_component_fraction",
    "mean_lineage_depth",
    "c2_proxy_norm",
    "feature_visibility"
  ],
  "properties": {
    "block_id": {
      "type": "string"
    },
    "window_start": {
      "type": "number",
      "minimum": 0
    },
    "window_end": {
      "type": "number",
      "minimum": 0
    },
    "collision_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_pair_count": {
      "type": "integer",
      "minimum": 0
    },
    "repeated_pair_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "vertex_count": {
      "type": "integer",
      "minimum": 0
    },
    "component_count": {
      "type": "integer",
      "minimum": 0
    },
    "cycle_rank": {
      "type": "integer",
      "minimum": 0
    },
    "largest_component_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mean_lineage_depth": {
      "type": "number",
      "minimum": 0
    },
    "c2_proxy_norm": {
      "type": "number",
      "minimum": 0
    },
    "feature_visibility": {
      "enum": [
        "runtime_observable",
        "shadow_probe",
        "oracle_only"
      ]
    }
  }
}
