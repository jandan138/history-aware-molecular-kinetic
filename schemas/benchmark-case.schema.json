{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hamk.dev/schemas/benchmark-case/1.0.0",
  "title": "HAMK benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "suite",
    "title",
    "status",
    "physics",
    "initial_condition",
    "methods",
    "sampling",
    "outputs",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(R0|B[0-5])-[A-Z0-9-]+-v[0-9]+$"
    },
    "suite": {
      "enum": [
        "R0",
        "B0",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "frozen",
        "retired"
      ]
    },
    "physics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "dimension",
        "model",
        "domain",
        "species"
      ],
      "properties": {
        "dimension": {
          "enum": [
            2,
            3
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "object"
        },
        "species": {
          "type": "array",
          "minItems": 1
        },
        "packing_fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "initial_condition": {
      "type": "object"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sampling": {
      "type": "object",
      "required": [
        "end_time",
        "interval",
        "seeds"
      ],
      "properties": {
        "end_time": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "interval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "operator",
          "value"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "operator": {
            "enum": [
              "less",
              "less_equal",
              "greater",
              "greater_equal",
              "between",
              "equal"
            ]
          },
          "value": {}
        }
      }
    }
  }
}
