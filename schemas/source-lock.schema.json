{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jandan138/history-aware-molecular-kinetic/schemas/source-lock.schema.json",
  "title": "External Source Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "repository",
    "revision",
    "default_branch",
    "license",
    "integration",
    "validated_against"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "integration": {
      "type": "string",
      "enum": ["external_process", "reference_only"]
    },
    "validated_against": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
