{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hamk.dev/schemas/metrics-report/1.0.0",
  "title": "HAMK metrics report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "metrics",
    "pass_fail"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "units",
          "aggregation"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "units": {
            "type": "string"
          },
          "aggregation": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "pass_fail": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
